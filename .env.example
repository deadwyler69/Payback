# Payback-Zugangsdaten (DEIN eigener Account)
# Kopiere diese Datei nach  .env  und trage deine Daten ein:
#     cp .env.example .env
# Danach laden mit:  set -a; source .env; set +a

# Login-Kennung: je nach Account E-Mail ODER Payback-Kartennummer
PAYBACK_USER=deine@email.de
PAYBACK_PASS=deinPasswort

# --- Optional: nur aendern, falls Payback die URLs/Struktur umstellt ---
# PAYBACK_LOGIN_URL=https://www.payback.de/login
# PAYBACK_COUPONS_URL=https://www.payback.de/coupons
# PAYBACK_TIMEOUT_MS=20000
# PAYBACK_SCREENSHOT_DIR=screenshots
# PAYBACK_CHROMIUM_EXECUTABLE=/pfad/zu/chromium   # falls Playwright ihn nicht findet
